#!/usr/bin/env python3
"""Check a private Dijkstra node, optionally submitting a transaction."""

import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time


ROOT = Path(__file__).resolve().parents[1]
NODE = "cardano-node:exe:cardano-node"
CHECK = "minutxo-node:exe:check-node"
CLI = "cardano-cli:exe:cardano-cli"
PLUTUS_CHECK = "minutxo-plutus-node:exe:check-plutus-node"


def terminate(signum, _frame):
    raise SystemExit(128 + signum)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--offline", action="store_true")
    submission = parser.add_mutually_exclusive_group()
    submission.add_argument("--submit-ada", action="store_true",
                            help="After startup, submit and verify one ordinary ADA transfer")
    submission.add_argument("--fund-tokens", action="store_true",
                            help="After startup, mint and fund two token-only store-backed inputs")
    submission.add_argument("--query-cli-utxo", action="store_true",
                            help="Fund token inputs, then verify CLI JSON and text UTxO queries")
    submission.add_argument("--submit-cli-transaction", action="store_true",
                            help="Use the CLI to build, sign and submit a token-only output, then verify inclusion and backing")
    submission.add_argument("--auto-deposit", action="store_true",
                            help="Automatically price a top-level token-only output's deposit, then submit and verify it")
    submission.add_argument("--release-deposit", action="store_true",
                            help="Fund token inputs, then consolidate them using only the deposit release for fee/change")
    submission.add_argument("--submit-nested-parent", action="store_true",
                            help="Fund token inputs, then submit a child whose extra deposit is paid by its parent")
    submission.add_argument("--submit-nested-sibling", action="store_true",
                            help="Fund token inputs, then submit a token child whose extra deposit is paid by an ADA sibling")
    submission.add_argument("--plutus-ordinary", action="store_true",
                            help="Execute a V4 validator spending an ordinary output and verify inclusion")
    submission.add_argument("--plutus-store-backed", action="store_true",
                            help="Execute the same V4 application rule with zero-ADA script outputs and verify backing")
    submission.add_argument("--plutus-negative", action="store_true",
                            help="Reject an invalid token-only datum transition, then include the valid spend")
    args = parser.parse_args()
    needs_cli = args.query_cli_utxo or args.submit_cli_transaction
    needs_plutus = args.plutus_ordinary or args.plutus_store_backed or args.plutus_negative
    project = "cabal.project.minutxo-node-cli" if needs_cli else "cabal.project.minutxo-node"
    if needs_plutus:
        project = "cabal.project.minutxo-plutus-node"
    options = [f"--project-file={project}",
               "--builddir=.workspace/minutxo-incremental/build"]
    if args.offline:
        options.append("--offline")
    targets = [NODE, CHECK, CLI] if needs_cli else [NODE, CHECK]
    if needs_plutus:
        targets.append(PLUTUS_CHECK)
    subprocess.run(["cabal", "build", *options, *targets], cwd=ROOT, check=True)

    def binary(target):
        return subprocess.check_output(
            ["cabal", "list-bin", *options, target], cwd=ROOT, text=True
        ).strip()

    node, check = binary(NODE), binary(CHECK)
    cli = binary(CLI) if needs_cli else None
    plutus_check = binary(PLUTUS_CHECK) if needs_plutus else None
    # A short, private path keeps the Unix socket within the platform limit.
    os.umask(0o077)
    directory = Path(tempfile.mkdtemp(prefix="minutxo-node-"))
    print(f"Local node files and logs: {directory}", flush=True)
    subprocess.run([check, "prepare", str(directory)], cwd=ROOT, check=True)
    socket = directory / "node.sock"
    command = [node, "run", "--config", str(directory / "config.json"),
               "--topology", str(directory / "topology.json"),
               "--database-path", str(directory / "db"),
               "--socket-path", str(socket), "--host-addr", "127.0.0.1", "--port", "0",
               "--shelley-kes-key", str(directory / "node.kes.skey"),
               "--shelley-vrf-key", str(directory / "node.vrf.skey"),
               "--shelley-operational-certificate", str(directory / "node.opcert")]
    (directory / "command.json").write_text(json.dumps(command, indent=2) + "\n")
    signal.signal(signal.SIGTERM, terminate)
    with (directory / "node.log").open("w") as log:
        process = subprocess.Popen(command, cwd=directory, stdout=log, stderr=subprocess.STDOUT)
        try:
            print("RUN node assertions: wait for advancing Dijkstra blocks", flush=True)
            deadline = time.monotonic() + 180
            first_block = None
            while time.monotonic() < deadline:
                if process.poll() is not None:
                    raise RuntimeError(f"Node exited with {process.returncode}; see {directory / 'node.log'}")
                if socket.exists():
                    result = subprocess.run([check, "probe", str(socket)],
                                            capture_output=True, text=True, timeout=15)
                    (directory / "probe.stdout").write_text(result.stdout)
                    (directory / "probe.stderr").write_text(result.stderr)
                    if result.returncode:
                        raise RuntimeError(f"Node query failed: {result.stderr or result.stdout}")
                    tip = json.loads(result.stdout)
                    if tip["isDijkstra"] and tip["block"] > 0:
                        if first_block is None:
                            first_block = tip["block"]
                        elif tip["block"] > first_block:
                            (directory / "ready-tip.json").write_text(json.dumps(tip, indent=2) + "\n")
                            print(f"PASS: Dijkstra blocks advanced from {first_block} to {tip['block']}", flush=True)
                            if args.plutus_ordinary:
                                subprocess.run([plutus_check, "ordinary", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=270)
                            if args.plutus_store_backed:
                                subprocess.run([plutus_check, "store-backed", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=270)
                            if args.plutus_negative:
                                subprocess.run([plutus_check, "store-backed-negative", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=270)
                            if args.submit_ada:
                                subprocess.run([check, "transfer", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=150)
                            if args.auto_deposit:
                                subprocess.run([check, "auto-deposit", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=150)
                            if args.submit_cli_transaction:
                                subprocess.run([check, "cli-transaction", cli, str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=180)
                            if args.fund_tokens or args.query_cli_utxo or args.release_deposit or args.submit_nested_parent or args.submit_nested_sibling:
                                subprocess.run([check, "fund-tokens", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=150)
                            if args.query_cli_utxo:
                                print("RUN CLI read assertions: token-only store-backed outputs and ordinary ADA change", flush=True)
                                subprocess.run([sys.executable, str(ROOT / "checks/node/cli_utxo.py"),
                                                cli, str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=150)
                            if args.release_deposit:
                                subprocess.run([check, "release-deposit", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=150)
                            if args.submit_nested_parent:
                                subprocess.run([check, "nested-parent", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=150)
                            if args.submit_nested_sibling:
                                subprocess.run([check, "nested-sibling", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=270)
                            return
                time.sleep(1)
            raise RuntimeError(f"Dijkstra blocks did not advance within 180 seconds; see {directory / 'node.log'}")
        finally:
            # This is the single process started here; no PID files or other nodes are touched.
            if process.poll() is None:
                process.send_signal(signal.SIGINT)
                try:
                    process.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            print("Local node stopped; its files and logs are retained.", flush=True)


if __name__ == "__main__":
    main()
