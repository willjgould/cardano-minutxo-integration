#!/usr/bin/env python3
"""Check a private Dijkstra node, optionally submitting one ordinary ADA transfer."""

import argparse
import json
import os
from pathlib import Path
import signal
import subprocess
import tempfile
import time


ROOT = Path(__file__).resolve().parents[1]
NODE = "cardano-node:exe:cardano-node"
CHECK = "minutxo-node:exe:check-node"


def terminate(signum, _frame):
    raise SystemExit(128 + signum)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--offline", action="store_true")
    parser.add_argument("--submit-ada", action="store_true",
                        help="After startup, submit and verify one ordinary ADA transfer")
    args = parser.parse_args()
    options = ["--project-file=cabal.project.minutxo-node",
               "--builddir=.workspace/minutxo-incremental/build"]
    if args.offline:
        options.append("--offline")
    subprocess.run(["cabal", "build", *options, NODE, CHECK], cwd=ROOT, check=True)

    def binary(target):
        return subprocess.check_output(
            ["cabal", "list-bin", *options, target], cwd=ROOT, text=True
        ).strip()

    node, check = binary(NODE), binary(CHECK)
    # A short, private path keeps the Unix socket within the platform limit.
    os.umask(0o077)
    directory = Path(tempfile.mkdtemp(prefix="minutxo-node-"))
    print(f"Local node files and logs: {directory}", flush=True)
    subprocess.run([check, "prepare", str(directory)], cwd=ROOT, check=True)
    socket = directory / "node.sock"
    command = [node, "run", "--config", str(directory / "config.json"),
               "--topology", str(directory / "topology.json"),
               "--database-path", str(directory / "db"),
               "--socket-path", str(socket), "--host-addr", "127.0.0.1", "--port", "0",
               "--shelley-kes-key", str(directory / "node.kes.skey"),
               "--shelley-vrf-key", str(directory / "node.vrf.skey"),
               "--shelley-operational-certificate", str(directory / "node.opcert")]
    (directory / "command.json").write_text(json.dumps(command, indent=2) + "\n")
    signal.signal(signal.SIGTERM, terminate)
    with (directory / "node.log").open("w") as log:
        process = subprocess.Popen(command, cwd=directory, stdout=log, stderr=subprocess.STDOUT)
        try:
            print("RUN node assertions: wait for advancing Dijkstra blocks", flush=True)
            deadline = time.monotonic() + 180
            first_block = None
            while time.monotonic() < deadline:
                if process.poll() is not None:
                    raise RuntimeError(f"Node exited with {process.returncode}; see {directory / 'node.log'}")
                if socket.exists():
                    result = subprocess.run([check, "probe", str(socket)],
                                            capture_output=True, text=True, timeout=15)
                    (directory / "probe.stdout").write_text(result.stdout)
                    (directory / "probe.stderr").write_text(result.stderr)
                    if result.returncode:
                        raise RuntimeError(f"Node query failed: {result.stderr or result.stdout}")
                    tip = json.loads(result.stdout)
                    if tip["isDijkstra"] and tip["block"] > 0:
                        if first_block is None:
                            first_block = tip["block"]
                        elif tip["block"] > first_block:
                            (directory / "ready-tip.json").write_text(json.dumps(tip, indent=2) + "\n")
                            print(f"PASS: Dijkstra blocks advanced from {first_block} to {tip['block']}", flush=True)
                            if args.submit_ada:
                                subprocess.run([check, "transfer", str(directory), str(socket)],
                                               cwd=ROOT, check=True, timeout=150)
                            return
                time.sleep(1)
            raise RuntimeError(f"Dijkstra blocks did not advance within 180 seconds; see {directory / 'node.log'}")
        finally:
            # This is the single process started here; no PID files or other nodes are touched.
            if process.poll() is None:
                process.send_signal(signal.SIGINT)
                try:
                    process.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            print("Local node stopped; its files and logs are retained.", flush=True)


if __name__ == "__main__":
    main()
