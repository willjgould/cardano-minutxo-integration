#!/usr/bin/env python3
"""Local build/check entrypoints for the pinned minUTxO source workspace."""

import argparse
import json
from pathlib import Path
import shlex
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
API = ROOT / "cardano-api"
REPOSITORIES = (
    "cardano-ledger-specs",
    "cardano-api",
    "cardano-cli",
    "cardano-wallet",
    "cardano-balance-transaction",
)
FOCUSED_TEST_OPTIONS = (
    "--pattern=/OutputVariants/||/MixedOutputInspection/"
    "||/DepositStoreInspection/||/Collateral/ +RTS -N2 -RTS"
)
CLI_PROJECT = """-- Generated by scripts/workspace; edit the generator instead.
-- Imported package paths are resolved against --project-dir=cardano-api.
import: ../cardano-api/cabal.project.collateral
packages: ../cardano-cli/cardano-cli

package cardano-cli
  tests: False
  benchmarks: False

-- The CLI pin declares API 11.6; this workspace carries migrated API 11.8.
-- This permits the build attempt; it does not establish source compatibility.
allow-newer:
  cardano-cli:cardano-api,
  cardano-cli:cardano-crypto-wrapper,
  vary:aeson
"""


def run(command, *, cwd=ROOT, dry_run=False):
    command = [str(arg) for arg in command]
    print(f"[{cwd}] {shlex.join(command)}", flush=True)
    if not dry_run:
        subprocess.run(command, cwd=cwd, check=True)


def require_files(*paths):
    missing = [str(path.relative_to(ROOT)) for path in paths if not path.is_file()]
    if missing:
        raise SystemExit(
            "Required workspace files are missing: " + ", ".join(missing)
            + ". Initialize the pinned submodules first."
        )


def nix_command():
    # JSON supplies string quoting; escape Nix interpolation in unusual paths.
    shell_path = json.dumps(str(ROOT / "shell.nix")).replace("${", "\\${")
    return [
        "nix", "develop", "--impure", "--expr",
        "import (builtins.toPath " + shell_path + ")",
    ]


def prepare(dry_run):
    for name in (
        "prepare-v2-minutxo-deps.py",
        "prepare-v2-minutxo-collateral-deps.py",
    ):
        run([sys.executable, API / "scripts" / name], cwd=API, dry_run=dry_run)


def write_cli_project(dry_run):
    destination = ROOT / ".workspace" / "cabal.project.cli"
    if dry_run:
        print(f"Would generate {destination}:\n{CLI_PROJECT}", flush=True)
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        if destination.exists() and not destination.read_text().startswith(
            "-- Generated by scripts/workspace;"
        ):
            raise SystemExit(f"Refusing to overwrite an unrelated project: {destination}")
        destination.write_text(CLI_PROJECT)
    return destination


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--dry-run", action="store_true", help="Print commands without running them or writing generated files")
    result.add_argument("--in-shell", action="store_true", help=argparse.SUPPRESS)
    result.add_argument("--jobs", type=int, default=6, help="Cabal build jobs (default: 6)")
    actions = result.add_subparsers(dest="action", required=True)
    actions.add_parser("status", help="Show submodule revisions and working-tree changes")
    actions.add_parser("prepare", help="Prepare the API's pinned compatibility dependencies")
    for name, description in (
        ("shell", "Enter the workspace shell, optionally with --command PROGRAM ..."),
        ("build-api", "Build the migrated API library"),
        ("test-api-focused", "Run the previously used focused API test selection"),
        ("check-collateral", "Run the API/full-ledger probe, including known ledger failures"),
        ("build-cli", "Attempt the CLI against the current API dependency closure"),
    ):
        action = actions.add_parser(name, help=description)
        if name == "shell":
            action.add_argument("--command", dest="shell_command", nargs=argparse.REMAINDER, help="Run a command in the pinned shell")
        action.add_argument("arguments", nargs=argparse.REMAINDER, help="Arguments passed to the underlying command; prefix with --")
    return result


def main():
    argument_parser = parser()
    options = argument_parser.parse_args()
    if options.jobs < 1:
        argument_parser.error("--jobs must be positive")
    arguments = getattr(options, "arguments", [])
    if arguments[:1] == ["--"]:
        arguments = arguments[1:]
    if getattr(options, "shell_command", None) is not None:
        if arguments:
            argument_parser.error("Use only one shell command")
        arguments = ["--command", *options.shell_command]

    if options.action == "status":
        run(["git", "submodule", "status", "--recursive"], dry_run=options.dry_run)
        for name in REPOSITORIES:
            path = ROOT / name
            if not options.dry_run and not (path / ".git").exists():
                print(f"{name}: submodule is not initialized", flush=True)
                continue
            run(["git", "status", "--short", "--branch"], cwd=path, dry_run=options.dry_run)
        return

    if not options.dry_run:
        require_files(ROOT / "shell.nix", API / "shell-v2-minutxo.nix", ROOT / "cardano-ledger-specs" / "flake.nix")

    if options.action == "shell":
        if arguments and arguments[0] != "--command":
            argument_parser.error("shell accepts --command PROGRAM [ARGUMENT ...]")
        if arguments == ["--command"]:
            argument_parser.error("--command requires a program")
        run(nix_command() + arguments, dry_run=options.dry_run)
        return

    if options.action == "prepare":
        prepare(options.dry_run)
        return

    if not options.in_shell:
        # Re-enter using the pinned environment even if another Nix shell is active.
        command = nix_command() + [
            "--command", "python3", str(Path(__file__).resolve()),
            "--in-shell", "--jobs", str(options.jobs),
        ]
        if options.dry_run:
            # Show both the environment command and all commands it will contain.
            run(command + [options.action, "--", *arguments], dry_run=True)
        else:
            run(command + [options.action, "--", *arguments])
            return

    if options.action == "check-collateral":
        print(
            "The recorded collateral probe constructed 50 cases: 34 ledger checks passed; "
            "16 hit the unfinished store-backed collateral rule. This command preserves "
            "a failing exit status and writes per-case results under "
            "cardano-api/dist-newstyle/v2-minutxo-collateral-check/.",
            flush=True,
        )
        run(
            [sys.executable, API / "scripts/check-v2-minutxo-collateral.py", "--in-shell", *arguments],
            cwd=API, dry_run=options.dry_run,
        )
        return

    prepare(options.dry_run)
    if options.action == "build-cli":
        write_cli_project(options.dry_run)
        print("Building CLI against API 11.8 is an integration check; the older successful CLI build used a different API/dependency closure.", flush=True)
        command = [
            "cabal", "build", "--project-dir=" + str(API),
            "--project-file=../.workspace/cabal.project.cli",
            "--builddir=" + str(ROOT / ".workspace/dist-cli"),
            "cardano-cli:exe:cardano-cli",
        ]
    elif options.action == "build-api":
        command = ["cabal", "build", "--project-file=cabal.project.collateral", "cardano-api:lib:cardano-api"]
    else:
        command = [
            "cabal", "test", "--project-file=cabal.project.collateral",
            "cardano-api:test:cardano-api-test", "--test-options=" + FOCUSED_TEST_OPTIONS,
        ]
    run(command + ["-j" + str(options.jobs), *arguments], cwd=API, dry_run=options.dry_run)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode)
    except FileNotFoundError as error:
        raise SystemExit(f"Required command or file is unavailable: {error.filename}")
