#!/usr/bin/env python3
"""Check dependencies, compilation, Plutus contexts, transactions, or the prototype node."""

import argparse
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
TARGET = "cardano-api:lib:cardano-api"
TRANSACTION_TARGETS = {
    "transaction": "minutxo-transaction:exe:check-transaction",
    "store-backed": "minutxo-transaction:exe:check-store-backed-transaction",
    "read-back": "minutxo-transaction:exe:check-store-backed-readback",
    "utxo-json": "minutxo-transaction:exe:check-utxo-json",
    "nested": "minutxo-transaction:exe:check-nested-transaction",
    "serialisation": "minutxo-transaction:exe:check-transaction-serialisation",
    "signing": "minutxo-transaction:exe:check-nested-signing",
}
PLUTUS_CONTEXT_CHECKS = {
    "plutus-mixed-outputs": "mixed-output-v4-context preserves both output values in order",
    "plutus-mixed-inputs": "mixed-input-v4-context preserves both resolved input values",
}


def run(command, log):
    line = "$ " + shlex.join(str(part) for part in command) + "\n"
    print(line, end="", flush=True)
    log.write(line)
    try:
        with subprocess.Popen(
            command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
        ) as process:
            for line in process.stdout:
                print(line, end="", flush=True)
                log.write(line)
            return process.wait()
    except FileNotFoundError as error:
        line = f"Cannot run {command[0]}: {error}\n"
        print(line, end="", flush=True)
        log.write(line)
        return 127


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("step", nargs="?", choices=("dependencies", "plutus-dependencies", "plutus-build", "plutus-compiler-dependencies", "plutus-compiler-build", "plutus-node-dependencies", "plutus-node-build", *PLUTUS_CONTEXT_CHECKS, "build", "transaction", "store-backed", "read-back", "utxo-json", "nested", "serialisation", "signing", "node-build", "cli-build", "cli-store-backed", "node", "node-transaction", "node-token-funding", "node-cli-utxo", "node-cli-transaction", "node-auto-deposit", "node-deposit-release", "node-nested-parent", "node-nested-sibling", "node-plutus-ordinary", "node-plutus-store-backed", "node-plutus-negative", "node-plutus-nested-parent"),
                        default="dependencies",
                        help="Resolve dependencies (default), compile a target, or check a Plutus context/transaction/node")
    parser.add_argument("--offline", action="store_true", help="Use cached Cabal packages only")
    args = parser.parse_args()
    project = {
        "plutus-dependencies": "cabal.project.minutxo-plutus",
        "plutus-build": "cabal.project.minutxo-plutus",
        "plutus-compiler-dependencies": "cabal.project.minutxo-plutus-compiler",
        "plutus-compiler-build": "cabal.project.minutxo-plutus-compiler",
        "plutus-node-dependencies": "cabal.project.minutxo-plutus-node",
        "plutus-node-build": "cabal.project.minutxo-plutus-node",
        **dict.fromkeys(PLUTUS_CONTEXT_CHECKS, "cabal.project.minutxo-plutus"),
        "node-build": "cabal.project.minutxo-node",
        "cli-build": "cabal.project.minutxo-cli",
    }.get(args.step, "cabal.project.minutxo-incremental")
    options = [f"--project-file={project}",
               "--builddir=.workspace/minutxo-incremental/build"]
    if args.offline:
        options.append("--offline")
    if args.step in ("dependencies", "plutus-dependencies", "plutus-compiler-dependencies", "plutus-node-dependencies"):
        options.append("--dry-run")
    target = {
        "plutus-dependencies": "cardano-ledger-dijkstra:test:tests",
        "plutus-build": "cardano-ledger-dijkstra:test:tests",
        "plutus-compiler-dependencies": "plutus-preprocessor:lib:plutus-preprocessor",
        "plutus-compiler-build": "plutus-preprocessor:lib:plutus-preprocessor",
        "plutus-node-dependencies": "minutxo-plutus-node:exe:check-plutus-node",
        "plutus-node-build": "minutxo-plutus-node:exe:check-plutus-node",
        **dict.fromkeys(PLUTUS_CONTEXT_CHECKS, "cardano-ledger-dijkstra:test:tests"),
        "node-build": "cardano-node:exe:cardano-node",
        "cli-build": "cardano-cli:exe:cardano-cli",
    }.get(args.step, TARGET)
    command = (["cabal", "run", *options, TRANSACTION_TARGETS[args.step]]
               if args.step in TRANSACTION_TARGETS
               else ["cabal", "build", *options, target])
    if args.step == "plutus-node-build":
        command.extend(["cardano-node:exe:cardano-node", "minutxo-node:exe:check-node"])
    if args.step in PLUTUS_CONTEXT_CHECKS:
        command = [
            "cabal", "test", *options, target,
            "--test-show-details=direct",
            "--test-option=--ignore-dot-hspec",
            "--test-option=--fail-on=empty,pending",
            f"--test-option=--match={PLUTUS_CONTEXT_CHECKS[args.step]}",
        ]
    if args.step in ("node", "node-transaction", "node-token-funding", "node-cli-utxo", "node-cli-transaction", "node-auto-deposit", "node-deposit-release", "node-nested-parent", "node-nested-sibling", "node-plutus-ordinary", "node-plutus-store-backed", "node-plutus-negative", "node-plutus-nested-parent"):
        command = [str(ROOT / "scripts/check-minutxo-node")]
        if args.step == "node-transaction":
            command.append("--submit-ada")
        if args.step == "node-token-funding":
            command.append("--fund-tokens")
        if args.step == "node-cli-utxo":
            command.append("--query-cli-utxo")
        if args.step == "node-cli-transaction":
            command.append("--submit-cli-transaction")
        if args.step == "node-auto-deposit":
            command.append("--auto-deposit")
        if args.step == "node-deposit-release":
            command.append("--release-deposit")
        if args.step == "node-nested-parent":
            command.append("--submit-nested-parent")
        if args.step == "node-nested-sibling":
            command.append("--submit-nested-sibling")
        if args.step == "node-plutus-ordinary":
            command.append("--plutus-ordinary")
        if args.step == "node-plutus-store-backed":
            command.append("--plutus-store-backed")
        if args.step == "node-plutus-nested-parent":
            command.append("--plutus-nested-parent")
        if args.step == "node-plutus-negative":
            command.append("--plutus-negative")
        if args.offline:
            command.append("--offline")

    checks = ROOT / ".workspace/minutxo-incremental/checks"
    checks.mkdir(parents=True, exist_ok=True)
    report = Path(tempfile.mkdtemp(prefix="run-", dir=checks))
    if args.step == "cli-store-backed":
        command = [sys.executable, str(ROOT / "checks/transaction/cli_store_backed.py"),
                   "--directory", str(report)]
        if args.offline:
            command.append("--offline")
    print(f"Logs: {report}", flush=True)
    print(f"\nRUN {args.step}", flush=True)
    with (report / f"{args.step}.log").open("w") as log:
        exit_code = run(command, log)

    state = "GREEN" if exit_code == 0 else f"RED (exit {exit_code})"
    summary = f"{args.step:22} {state}\n"
    (report / "summary.txt").write_text(summary)
    display = summary.rstrip()
    if sys.stdout.isatty() and "NO_COLOR" not in os.environ:
        color = "32" if exit_code == 0 else "31"
        display = f"\033[{color}m{display}\033[0m"
    print(f"\n{display}")
    print(f"\nSaved: {report / 'summary.txt'}")
    # Subprocess signal return codes are negative; shell exit codes use 128+signal.
    return exit_code if exit_code >= 0 else 128 - exit_code


if __name__ == "__main__":
    raise SystemExit(main())
