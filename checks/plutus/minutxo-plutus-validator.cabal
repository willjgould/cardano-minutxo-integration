cabal-version: 3.0
name: minutxo-plutus-validator
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: MinUTxO.Validator
  other-modules: MinUTxO.Validator.OnChain
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options:
    -Wall -Werror
    -fno-ignore-interface-pragmas
    -fno-omit-interface-pragmas
    -fno-full-laziness
    -fno-spec-constr
    -fno-specialise
    -fno-strictness
    -fno-unbox-strict-fields
    -fno-unbox-small-strict-fields
  build-depends:
    base >= 4.18 && < 4.19,
    bytestring,
    plutus-ledger-api == 1.71.0.0,
    plutus-tx == 1.71.0.0,
    plutus-tx-plugin == 1.71.0.0
