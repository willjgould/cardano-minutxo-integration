cabal-version: 3.0
name: minutxo-transaction
version: 0.1.0.0
build-type: Simple

executable check-transaction
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wno-deprecations
  build-depends:
    base >= 4.18 && < 4.19,
    cardano-api,
    microlens

executable check-store-backed-transaction
  main-is: StoreBacked.hs
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wno-deprecations
  build-depends:
    base >= 4.18 && < 4.19,
    cardano-api,
    cardano-ledger-core,
    microlens

executable check-store-backed-readback
  main-is: ReadBack.hs
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wno-deprecations
  build-depends:
    base >= 4.18 && < 4.19,
    cardano-api,
    cardano-ledger-core

executable check-nested-transaction
  main-is: Nested.hs
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wno-deprecations -main-is Nested.main
  build-depends:
    base >= 4.18 && < 4.19,
    cardano-api,
    cardano-ledger-core,
    cardano-ledger-dijkstra,
    containers,
    microlens

executable check-transaction-serialisation
  main-is: Serialisation.hs
  other-modules: Nested
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wno-deprecations
  build-depends:
    base >= 4.18 && < 4.19,
    cardano-api,
    cardano-ledger-core,
    cardano-ledger-dijkstra,
    containers,
    microlens
