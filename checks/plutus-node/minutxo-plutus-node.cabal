cabal-version: 3.0
name: minutxo-plutus-node
version: 0.1.0.0
build-type: Simple

executable check-plutus-node
  main-is: Main.hs
  hs-source-dirs: . ../node
  other-modules: AutoBalance, Submission, TokenFunding
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wno-deprecations
  build-depends:
    base >= 4.18 && < 4.19,
    aeson,
    bytestring,
    cardano-api,
    cardano-data,
    cardano-ledger-binary,
    cardano-ledger-core,
    cardano-ledger-dijkstra,
    cardano-ledger-shelley,
    containers,
    filepath,
    microlens,
    minutxo-plutus-validator,
    ouroboros-network:protocols,
    plutus-ledger-api == 1.71.0.0,
    process,
    text,
    time,
    transformers
