cabal-version: 3.0
name: minutxo-node
version: 0.1.0.0
build-type: Simple

executable check-node
  main-is: Main.hs
  other-modules: Genesis, NestedParent, Submission, TokenFunding
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wno-deprecations
  build-depends:
    base >= 4.18 && < 4.19,
    aeson,
    bytestring,
    cardano-api,
    cardano-data,
    cardano-ledger-binary,
    cardano-ledger-core,
    cardano-ledger-dijkstra,
    cardano-ledger-shelley,
    containers,
    filepath,
    microlens,
    ouroboros-network:protocols,
    text,
    time,
    transformers
