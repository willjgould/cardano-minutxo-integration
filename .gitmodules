[submodule "cardano-ledger-specs"]
	path = cardano-ledger-specs
	url = https://github.com/nhenin/cardano-ledger-specs.git
	branch = v2-minutxo
[submodule "cardano-api"]
	path = cardano-api
	url = https://github.com/willjgould/cardano-api.git
	branch = minutxo-incremental
[submodule "cardano-cli"]
	path = cardano-cli
	url = https://github.com/willjgould/cardano-cli.git
	branch = minutxo-incremental
[submodule "cardano-wallet"]
	path = cardano-wallet
	url = https://github.com/willjgould/cardano-wallet.git
	branch = master
[submodule "cardano-balance-transaction"]
	path = cardano-balance-transaction
	url = https://github.com/cardano-foundation/cardano-balance-transaction.git
	branch = main
[submodule "cardano-node"]
	path = cardano-node
	url = https://github.com/IntersectMBO/cardano-node.git
[submodule "cardano-ledger-read"]
	path = cardano-ledger-read
	url = https://github.com/willjgould/cardano-ledger-read.git
[submodule "ouroboros-consensus"]
	path = ouroboros-consensus
	url = https://github.com/IntersectMBO/ouroboros-consensus
[submodule "plutus"]
	path = plutus
	url = https://github.com/IntersectMBO/plutus.git
