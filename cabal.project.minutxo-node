import: cabal.project.minutxo-incremental

-- Match the official node 715b8d2a6 stack while using our local API and
-- Nicolas's rebased minUTxO ledger. trace-resources is a published dependency.
packages:
  checks/node
  cardano-node/cardano-node
  cardano-node/trace-forward
  cardano-api/cardano-rpc

package cardano-node
  flags: -systemd

-- Policy from that node's cabal.project.
package acts
  flags: -finitary

constraints:
  any.proto-lens >= 0.7.1.7,
  any.alfred-margaret < 2.1.1.0 || > 2.1.1.0
