import: cabal.project.minutxo-incremental

-- Resolve the declared wallet library and balancer against the integration
-- stack. Compilation and wallet behaviour are separate checks.
packages:
  cardano-wallet/lib/address-derivation-discovery
  cardano-wallet/lib/cardano-wallet-read
  cardano-wallet/lib/cardano-wallet-tracing
  cardano-wallet/lib/crypto-primitives
  cardano-wallet/lib/launcher
  cardano-wallet/lib/network-layer
  cardano-wallet/lib/numeric
  cardano-wallet/lib/primitive
  cardano-wallet/lib/secrets
  cardano-wallet/lib/test-utils
  cardano-wallet/lib/text-class
  cardano-wallet/lib/wallet
  cardano-balance-transaction
  cardano-ledger-read

-- Keep allowances for published packages within the selected stack's series.
-- The other relaxed dependencies below are fixed by local packages or source
-- pins in the imported project. These admit a plan, not source compatibility.
constraints:
  any.random >= 1.3 && < 1.4,
  any.cardano-crypto == 1.4.0,
  any.cardano-crypto-wrapper == 1.8.0.0,
  any.io-classes ^>= 1.8

allow-newer:
  -- Also used by the declared wallet project.
  cardano-coin-selection:random,
  delta-store:io-classes,
  -- The pinned ledger reader's bounds predate the integration stack.
  cardano-ledger-read:cardano-crypto,
  cardano-ledger-read:cardano-crypto-class,
  cardano-ledger-read:cardano-crypto-wrapper,
  cardano-ledger-read:cardano-ledger-alonzo,
  cardano-ledger-read:cardano-ledger-api,
  cardano-ledger-read:cardano-ledger-babbage,
  cardano-ledger-read:cardano-ledger-binary,
  cardano-ledger-read:cardano-ledger-conway,
  cardano-ledger-read:cardano-ledger-core,
  cardano-ledger-read:cardano-ledger-dijkstra,
  cardano-ledger-read:cardano-ledger-mary,
  cardano-ledger-read:cardano-ledger-shelley,
  cardano-ledger-read:cardano-protocol,
  cardano-ledger-read:ouroboros-consensus,
  cardano-ledger-read:ouroboros-network

-- Coin-selection source pin from cardano-wallet/cabal.project.
source-repository-package
  type: git
  location: https://github.com/cardano-foundation/cardano-coin-selection
  tag: 176611048d5b9f33df19d106cd925d63a7858bb2
